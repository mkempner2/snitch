# Required for the default Gmail SMTP setup.
# Copy this file to .env and fill in the blanks. Never commit .env.
GMAIL_USER=
GMAIL_APP_PASSWORD=
HOA_EMAIL=
PORT=3000

# Optional. IANA timezone used in the subject line and footer.
# Examples: America/New_York, America/Chicago, America/Denver, America/Los_Angeles.
# REPORT_TIMEZONE=UTC

# Optional. Gmail accepts 587 (STARTTLS, the default) and 465 (SSL).
# Render free and Railway Free/Hobby block both. Koyeb free allows 587.
# SMTP_PORT=587

# Set to 1 on Render, Koyeb, and any other reverse proxy so rate limits
# see the visitor's address. Render turns this on by itself.
# TRUST_PROXY=1

# Optional shared code. When set, the web form asks for it.
# Share it in the neighborhood newsletter. Inbound webhooks use INBOUND_SECRET
# instead of this code.
# ACCESS_CODE=

# Optional. Leave blank to keep email and SMS intake turned off.
# Use a long random string. The inbound script and any SMS app must send it.
# INBOUND_SECRET=

# Upload and abuse limits.
# MAX_PHOTOS=6
# MAX_TOTAL_MB=15
# NOTE_MAX_LENGTH=4000
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MIN=60
# DAILY_SEND_MAX=100

# Only for hosts that block SMTP (Render's free instance, Railway Free/Hobby).
# Leave MAIL_MODE unset, or set it to smtp, for normal Gmail SMTP.
# MAIL_MODE=smtp
# APPS_SCRIPT_URL=
# APPS_SCRIPT_SECRET=
